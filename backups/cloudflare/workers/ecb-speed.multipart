  `.ecb-step.active .ecb-step__circle,.ecb-step.done .ecb-step__circle,.ecb-step.completed .ecb-step__circle{background:${T.ink}!important;color:${T.canvas}!important}`,
  `.ecb-step__label{${label};font-size:10.5px!important;color:${T.ink}!important}`,
