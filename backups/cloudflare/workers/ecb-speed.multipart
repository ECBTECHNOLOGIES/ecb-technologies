    if (has(/cellular/)) facts.push(`${has(/cellular/)} are Wi-Fi + Cellular models (take a SIM card) and ${rows.length - has(/cellular/)} are Wi-Fi only.`);
    if (has(/-5g-/)) facts.push(`${has(/-5g-/)} listings mention 5G.`);
