  `.ecb-cat-range-output,.ecb-cat-price-display{font-family:${T.mono}!important;font-size:12px!important;color:${T.ink}!important}`,
  `.gs-pagination a,.gs-pagination span,.gs-pagination li,.gs-pagination .page-link{font-family:${T.mono}!important;font-size:12px!important;border-radius:6px!important;border-color:${T.hair}!important;color:${T.ink}!important;box-shadow:none!important;background:${T.canvas}!important}`,
  `.ecb-cat-tree-link.active,.ecb-cat-tree-link:hover{background:transparent!important;color:${T.ink}!important}`,
  `.ecb-cat-tree-toggle,.ecb-cat-tree-toggle svg{color:${T.ink}!important;background:transparent!important}`,
  `.ecb-cat-recent-list:empty,.ecb-cat-widget:has(.ecb-cat-recent-list:empty){display:none!important}`,
  `.gs-pagination .active a,.gs-pagination .active span,.gs-pagination a.active{background:${T.ink}!important;color:${T.canvas}!important;border-color:${T.ink}!important}`,

  // ---------- product page ----------
  `body:has(.ecb-pd-section) .gs-breadcrumb-section{display:none!important}`,
  `.ecb-pd-section{padding-top:24px!important}`,
  `.ecb-pd-stars,.ecb-pd-share-icons,.ecb-pd-rating-stars{filter:grayscale(1)}`,
