  // ---------- footer ----------
  `.ecb-footer,.ecb-footer-main,.ecb-footer-bottom{background:${T.ink}!important}`,
  `.ecb-footer-newsletter{background:#0d0d0d!important;border-top:1px solid #1f1f1f!important;border-bottom:1px solid #1f1f1f!important}`,
  `.ecb-newsletter-text,.ecb-newsletter-text *{color:${T.canvas}!important}`,
  `.ecb-newsletter-text h3,.ecb-newsletter-text h4,.ecb-newsletter-text strong{${display};font-size:20px!important}`,
