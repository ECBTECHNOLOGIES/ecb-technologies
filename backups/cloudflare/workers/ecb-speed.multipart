  `.ecb-newsletter-form button{background:${T.canvas}!important;color:${T.ink}!important;border-radius:0 6px 6px 0!important;${label};font-size:11px!important;box-shadow:none!important}`,
  `.ecb-footer-logo{display:none!important}`,
  `.ecb-footer-logo-link::after{content:"ECB TECHNOLOGIES";${display};font-size:22px;color:${T.canvas}}`,
  `.ecb-footer-tagline,.ecb-footer-contact-row,.ecb-footer-contact-row *,.ecb-footer-address-block,.ecb-footer-address-block *{color:#a6a6a6!important;font-size:13px!important}`,
  `.ecb-footer-heading{${display};font-size:20px!important;color:${T.canvas}!important;border:0!important}`,
  `.ecb-footer-heading::after,.ecb-footer-heading::before{display:none!important}`,
