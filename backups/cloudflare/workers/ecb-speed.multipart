  `.ecb-pd-trust-item svg{color:${T.ink}!important;stroke:currentColor}`,
  `.ecb-pd-info{background:${T.canvas}!important;border:1px solid ${T.hair}!important;border-radius:8px!important;box-shadow:none!important}`,
  `.ecb-pd-name{font-family:${T.sans}!important;font-weight:300!important;font-size:30px!important;line-height:1.2!important;letter-spacing:-.01em!important;color:${T.ink}!important}`,
  `@media (max-width:767px){.ecb-pd-name{font-size:23px!important}}`,
  `.ecb-pd-rating-val,.ecb-pd-rating-count{font-family:${T.mono}!important;font-size:11px!important;color:${T.muted}!important}`,
  `.ecb-pd-stars svg,.ecb-pd-stars i{color:#bdbdbd!important;fill:#bdbdbd!important}`,
  `.ecb-pd-stock-badge{background:${T.page}!important;color:${T.ink}!important;${label};font-size:10px!important;border:1px solid ${T.hair}!important;border-radius:4px!important}`,
  `.ecb-pd-price,#sizeprice{${display};font-size:42px!important;color:${T.ink}!important}`,
  `@media (max-width:767px){.ecb-pd-price,#sizeprice{font-size:32px!important}}`,
