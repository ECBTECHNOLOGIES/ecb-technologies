ackground: rgb(19, 34, 64); border-bottom: 1px solid rgba(255, 255, 255, 0.07); padding: 28px 0px; }\n.ecb-newsletter-inner { display: flex; align-items: center; gap: 32px; flex-wrap: wrap; }\n.ecb-newsletter-text { display: flex; align-items: center; gap: 16px; flex: 1 1 0%; min-width: 280px; }\n.ecb-newsletter-text svg { flex-shrink: 0; }\n.ecb-newsletter-text h3 { font-size: 16px; font-weight: 700; color: rgb(255, 255, 255); margin: 0px 0px 3px; }\n.ecb-newsletter-text p { font-size: 13px; color: rgba(255, 255, 255, 0.55); margin: 0px; }\n.ecb-newsletter-form { display: flex; flex: 1 1 0%; max-width: 440px; min-width: 260px; border: 1.5px solid rgba(255, 255, 255, 0.18); border-radius: 8px; overflow: hidden; background: rgba(255, 255, 255, 0.05); }\n.ecb-newsletter-form input { flex: 1 1 0%; background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px 16px; font-size: 14px; color: rgb(255, 255, 255); outline: none; min-width: 0px; }\n.ecb-newsletter-form input::placeholder { color: rgba(255, 255, 255, 0.4); }\n.ecb-newsletter-form button { flex-shrink: 0; background: rgb(22, 131, 255); color: rgb(255, 255, 255); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 12px 22px; font-size: 13.5px; font-weight: 700; cursor: pointer; transition: background 0.2s; white-space: nowrap; }\n.ecb-newsletter-form button:hover { background: rgb(13, 110, 224); }\n.ecb-footer-main { background: rgb(12, 26, 46); padding: 48px 0px 40px; }\n.ecb-footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.2fr; gap: 40px; }\n.ecb-footer-heading { font-size: 14px; font-weight: 700; color: rgb(255, 255, 255); text-transform: uppercase; letter-spacing: 1px; margin: 0px 0px 18px; padding-bottom: 12px; border-bottom: 2px solid rgb(22, 131, 255); display: inline-block; }\n.ecb-footer-logo { max-height: 52px; width: auto; display: block; margin-bottom: 14px; }\n.ecb-footer-tagline { font-size: 13px; color: rgba(255, 255, 255, 0.55); line-height: 1.65; margin: 0px 0px 18px; }\n.ecb-footer-contacts { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }\n.ecb-footer-contact-row { display: flex; align-items: center; gap: 10px; font-size: 13px; color: rgba(255, 255, 255, 0.7); transition: color 0.2s; }\n.ecb-footer-contact-row:hover { color: rgb(22, 131, 255); }\n.ecb-footer-contact-row svg { flex-shrink: 0; color: rgb(22, 131, 255); }\n.ecb-footer-socials { display: flex; gap: 8px; flex-wrap: wrap; }\n.ecb-footer-social { display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; background: rgba(255, 255, 255, 0.1); color: rgb(255, 255, 255); font-size: 14px; transition: background 0.2s, transform 0.15s; text-decoration: none; }\n.ecb-footer-social:hover { background: rgb(22, 131, 255); transform: translateY(-2px); color: rgb(255, 255, 255); }\n.ecb-footer-links { display: flex; flex-direction: column; gap: 10px; }\n.ecb-footer-links li a { display: flex; align-items: center; gap: 7px; font-size: 13.5px; color: rgba(255, 255, 255, 0.62); transition: color 0.2s, gap 0.15s; }\n.ecb-footer-links li a:hover { color: rgb(22, 131, 255); gap: 10px; }\n.ecb-footer-links li a svg { flex-shrink: 0; opacity: 0.5; }\n.ecb-footer-links li a:hover svg { opacity: 1; }\n.ecb-footer-map { border-radius: 8px; overflow: hidden; margin-bottom: 12px; border: 1px solid rgba(255, 255, 255, 0.1); }\n.ecb-footer-map iframe { display: block; }\n.ecb-footer-address-block { display: flex; align-items: flex-start; gap: 8px; font-size: 12.5px; color: rgba(255, 255, 255, 0.55); line-height: 1.5; }\n.ecb-footer-address-block svg { flex-shrink: 0; margin-top: 2px; }\n.ecb-footer-bottom { background: rgb(8, 20, 36); padding: 14px 0px; border-top: 1px solid rgba(255, 255, 255, 0.06); }\n.ecb-footer-bottom-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }\n.ecb-footer-copy { font-size: 13px; color: rgba(255, 255, 255, 0.45); margin: 0px; }\n.ecb-footer-bottom-links { display: flex; gap: 20px; }\n.ecb-footer-bottom-links a { font-size: 13px; color: rgba(255, 255, 255, 0.45); transition: color 0.2s; }\n.ecb-footer-bottom-links a:hover { color: rgb(22, 131, 255); }\n@media (max-width: 1199px){.ecb-footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }}\n@media (max-width: 767px){.ecb-footer-main { padding: 32px 0px 28px; }.ecb-footer-container { padding-left: 16px; padding-right: 16px; }.ecb-newsletter-inner { flex-direction: column; align-items: flex-start; gap: 14px; }.ecb-newsletter-form { max-width: 100%; width: 100%; }.ecb-newsletter-text h3 { font-size: 15px; }.ecb-newsletter-text p { font-size: 12px; }.ecb-footer-grid { grid-template-columns: 1fr 1fr; grid-template-areas: \"brand brand\" \"cats care\" \"find find\"; gap: 24px 20px; }.ecb-footer-col--brand { grid-area: brand; }.ecb-footer-col--cats { grid-area: cats; }.ecb-footer-col--care { grid-area: care; }.ecb-footer-col--find { grid-area: find; }.ecb-footer-logo { max-height: 40px; margin-bottom: 10px; }.ecb-footer-tagline { font-size: 12px; margin-bottom: 14px; }.ecb-footer-contacts { gap: 8px; margin-bottom: 14px; }.ecb-footer-contact-row { font-size: 12px; }.ecb-footer-social { width: 30px; height: 30px; }.ecb-footer-heading { font-size: 12px; letter-spacing: 0.8px; margin-bottom: 12px; padding-bottom: 8px; }.ecb-footer-links { gap: 8px; }.ecb-footer-links li a { font-size: 12.5px; }.ecb-footer-map iframe { height: 150px; }.ecb-footer-col--find { display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: 8px !important; }.ecb-footer-col--find .ecb-footer-heading { grid-column: 1 / -1; margin-bottom: 0px; }.ecb-footer-address-block { font-size: 12px; }.ecb-footer-bottom-inner { flex-direction: column; text-align: center; gap: 6px; }.ecb-footer-copy { font-size: 12px; }.ecb-footer-bottom-links { gap: 14px; }.ecb-footer-bottom-links a