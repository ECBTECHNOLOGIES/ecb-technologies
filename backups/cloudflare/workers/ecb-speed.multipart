, 131, 255); gap: 10px; }\n.ecb-footer-links li a svg { flex-shrink: 0; opacity: 0.5; }\n.ecb-footer-links li a:hover svg { opacity: 1; }\n.ecb-footer-map { border-radius: 8px; overflow: hidden; margin-bottom: 12px; border: 1px solid rgba(255, 255, 255, 0.1); }\n.ecb-footer-map iframe { display: block; }\n.ecb-footer-address-block { display: flex; align-items: flex-start; gap: 8px; font-size: 12.5px; color: rgba(255, 255, 255, 0.55); line-height: 1.5; }\n.ecb-footer-address-block svg { flex-shrink: 0; margin-top: 2px; }\n.ecb-footer-bottom { background: rgb(8, 20, 36); padding: 14px 0px; border-top: 1px solid rgba(255, 255, 255, 0.06); }\n.ecb-footer-bottom-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }\n.ecb-footer-copy { font-size: 13px; color: rgba(255, 255, 255, 0.45); margin: 0px; }\n.ecb-footer-bottom-links { display: flex; gap: 20px; }\n.ecb-footer-bottom-links a { font-size: 13px; color: rgba(255, 255, 255, 0.45); transition: color 0.2s; }\n.ecb-footer-bottom-links a:hover { color: rgb(22, 131, 255); }\n@media (max-width: 1199px){.ecb-footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }}\n@media (max-width: 767px){.ecb-footer-main { padding: 32px 0px 28px; }.ecb-footer-container { padding-left: 16px; padding-right: 16px; }.ecb-newsletter-inner { flex-direction: column; align-items: flex-start; gap: 14px; }.ecb-newsletter-form { max-width: 100%; width: 100%; }.ecb-newsletter-text h3 { font-size: 15px; }.ecb-newsletter-text p { font-size: 12px; }.ecb-footer-grid { grid-template-columns: 1fr 1fr; grid-template-areas: \"brand brand\" \"cats care\" \"find find\"; gap: 24px 20px; }.ecb-footer-col--brand { grid-area: brand; }.ecb-footer-col--cats { grid-area: cats; }.ecb-footer-col--care { grid-area: care; }.ecb-footer-col--find { grid-area: find; }.ecb-footer-logo { max-height: 40px; margin-bottom: 10px; }.ecb-footer-tagline { font-size: 12px; margin-bottom: 14px; }.ecb-footer-contacts { gap: 8px; ma