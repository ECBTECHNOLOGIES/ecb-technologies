  `.ecb-pd-qty-ctrl{border:1px solid ${T.hair}!important;border-radius:6px!important;box-shadow:none!important;background:${T.canvas}!important}`,
  `.ecb-pd-qty-btn{background:transparent!important;color:${T.ink}!important;border:0!important}`,
  `.ecb-pd-qty-input{font-family:${T.mono}!important;color:${T.ink}!important;border:0!important}`,
  `.ecb-pd-stock-count{background:${T.page}!important;color:${T.ink}!important;font-family:${T.mono}!important;font-size:10.5px!important}`,
  `.ecb-pd-btn-cart{${btnPrimary};height:48px!important;font-size:12px!important}`,
  `.ecb-pd-btn-buy{${btnSecondary};height:48px!important;font-size:12px!important}`,
  `.ecb-pd-btn-cart svg{color:${T.canvas}!important}.ecb-pd-btn-buy svg{color:${T.ink}!important}`,
  `.ecb-pd-btn-cart:hover{background:#222!important}.ecb-pd-btn-buy:hover{background:${T.ink}!important;color:${T.canvas}!important}`,
  `.ecb-pd-action-link,.ecb-pd-share-label,.ecb-pd-seller-label{${label};font-size:10.5px!important;color:${T.muted}!important}`,
  `.ecb-pd-share-icon svg circle,.ecb-pd-share-icon svg rect{fill:${T.ink}!important}`,
