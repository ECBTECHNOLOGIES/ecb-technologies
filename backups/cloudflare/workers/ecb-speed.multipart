  `.ecb-cat-tree-link.active,.ecb-cat-tree-row.active .ecb-cat-tree-link{font-weight:600!important}`,
  `.ecb-cat-filter-btn,.ecb-cat-filter-toggle{${btnPrimary}}.ecb-cat-clear-btn{${btnSecondary}}`,
  `.ecb-cat-filter-toggle svg{color:${T.canvas}!important}`,
  `.ecb-cat-toolbar{background:transparent!important;border:0!important;box-shadow:none!important;padding-left:0!important;padding-right:0!important}`,
  `.ecb-cat-count,.ecb-cat-count *,.ecb-cat-sort-label{${label};font-size:11px!important;color:${T.ink}!important}`,
  `.ecb-sort-pills{background:transparent!important;box-shadow:none!important}`,
  `.ecb-sort-pill{${label};font-size:11px!important;color:${T.muted}!important;background:transparent!important;border-radius:6px!important;box-shadow:none!important}`,
  `.ecb-sort-pill.active{background:${T.ink}!important;color:${T.canvas}!important}`,
  `.ecb-cat-view-toggle{background:transparent!important;box-shadow:none!important}`,
  `.ecb-cat-view-btn{background:${T.canvas}!important;border:1px solid ${T.hair}!important;border-radius:6px!important;color:${T.ink}!important;box-shadow:none!important}`,
  `.ecb-cat-view-btn.active{background:${T.ink}!important;color:${T.canvas}!important;border-color:${T.ink}!important}`,
