 { width: 100%; flex-flow: wrap; border-left-width: medium; border-left-style: none; border-left-color: currentcolor; border-top: 1.5px solid rgb(232, 238, 245); justify-content: space-between; padding: 14px 16px; }.ecb-cat-list-prices { flex-direction: row; align-items: baseline; gap: 8px; }.ecb-cat-list-actions { flex-direction: row; width: auto; flex: 1 1 0%; justify-content: flex-end; }.ecb-cat-list-view-btn { width: auto; padding: 8px 14px; }}\n@media (max-width: 480px){.ecb-cat-toolbar-right { gap: 6px; }.ecb-cat-sort-label { display: none; }.ecb-sort-pills { gap: 3px; padding: 2px; }.ecb-sort-pill { padding: 5px 8px; font-size: 11px; }}\n@media (max-width: 767px){body { padding-top: var(--ecb-header-h, 110px) !important; }.container { padding-left: 14px !important; padding-right: 14px !important; }.ecb-header, .ecb-topbar, .ecb-midbar, .ecb-header .container { max-width: 100vw; box-sizing: border-box; }.ecb-topbar__contact { overflow: hidden; }.ecb-topbar__login-btn { padding: 4px 8px; font-size: 10px; }.ecb-topbar__phone { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0px; flex: 1 1 auto; }}\n@media (max-width: 767px){.ecb-cat-section { padding: 16px 0px 32px; }}\n@media (max-width: 767px){.ecb-cat-toolbar { padding: 9px 12px; flex-wrap: wrap; gap: 8px; border-radius: 8px; }.ecb-cat-toolbar-left { width: 100%; justify-content: space-between; }.ecb-cat-toolbar-right { width: 100%; justify-content: space-between; gap: 6px; }.ecb-cat-count { font-size: 12.5px; }}\n@media (max-width: 480px){.ecb-cat-sort-label { display: none; }.ecb-sort-pill { padding: 5px 8px; font-size: 11px; }.ecb-cat-view-btn { width: 30px; height: 30px; }}\n@media (max-width: 767px){.ecb-cat-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }}\n@media (max-width: 380px){.ecb-cat-grid { grid-template-columns: 1fr; gap: 10px; }}\n@media (max-width: 767px){.ecb-cat-grid .ecb-fp-img-wrap { min-height: 140px; padding: 10px; }.ecb-cat-grid .ecb-fp-img-wrap img { max-height: 120px; }.ecb-cat-grid .ecb-fp-body { padding: 10px 10px 4px; gap: 3px; }.ecb-cat-grid .ecb-fp-name { font-size: 12.5px; -webkit-line-clamp: 2; min-height: calc(2.7em); }.ecb-cat-grid .ecb-fp-specs { display: none; }.ecb-cat-grid .ecb-fp-price { font-size: 14px; }.ecb-cat-grid .ecb-fp-footer { padding: 8px 10px 10px; }.ecb-cat-grid .ecb-fp-cart-btn { font-size: 12px; padding: 8px 4px; gap: 5px; }.ecb-cat-grid .ecb-fp-cart-btn svg { width: 13px; height: 13px; }}\n@media (max-width: 575px){.ecb-cat-list-img { height: 160px; padding: 12px; }.ecb-cat-list-name { font-size: 14px; }.ecb-cat-list-desc { -webkit-line-clamp: 1; }.ecb-cat-list-price { font-size: 17px; }.ecb-cat-list-footer { padding: 12px 14px; gap: 10px; }.ecb-cat-list-actions { gap: 6px; }.ecb-fp-cart-btn { font-size: 12px; padding: 8px 10px; }.ecb-cat-list-view-btn { font-size: 12px; padding: 7px 12px; }}\n@media (max-width: 575px){.ecb-cat-active-filters { gap: 6px; margin-bottom: 10px; }.ecb-cat-chip { font-size: 12px; padding: 3px 9px; }}\n@media (max-width: 991px){.ecb-cat-sidebar { position: fixed; top: 0px; left: -320px; width: min(300px, 88vw); height: 100vh; overflow-y: auto; background: rgb(255, 255, 255); z-index: 1050; padding: 16px 14px 48px; box-shadow: rgba(0, 0, 0, 0.18) 4px 0px 24px; transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1); gap: 12px; }}\n@media (max-width: 575px){.ecb-cat-widget-title { padding: 11px 14px; font-size: 12px; }.ecb-cat-tree-link { font-size: 13px; }.ecb-cat-filter-btn, .ecb-cat-clear-btn { width: calc(100% - 28px); margin-left: 14px; margin-right: 14px; }}\n@media (max-width: 575px){.ecb-cat-pagination .gs-pagination { gap: 4px; flex-wrap: wrap; justify-content: center; }.ecb-cat-pagination .gs-pagination li a, .ecb-cat-pagination .gs-pagination li span { width: 34px !important; height: 34px !important; font-size: 13px !important; border-radius: 6px !important; }}\n@media (max-width: 767px){.gs-breadcrumb-section { padding: 28px 0px !important; }.breadcrumb-title { font-size: 20px !important; }.bread-menu { font-size: 12.5px !important; }}\n@media (max-width: 767px){.ecb-pd-qty-btn, .ecb-pd-img-wish, .ecb-cat-view-btn, .ecb-cat-filter-toggle, .ecb-cat-list-wish, .ecb-fp-wish { min-width: 40px; min-height: 40px; }.gs-pagination li a, .gs-pagination li span { min-width: 36px; min-height: 36px; align-items: center; justify-content: center; display: inline-flex !important; }}\n@media (min-width: 1200px){.ecb-topbar { background: linear-gradient(90deg, rgb(9, 22, 40) 0%, rgb(12, 31, 56) 50%, rgb(9, 22, 40) 100%); border-bottom: 1px solid rgba(22, 131, 255, 0.18); }.ecb-topbar__address svg { color: rgb(77, 163, 255); filter: drop-shadow(rgba(22, 131, 255, 0.45) 0px 0px 4px); }.ecb-topbar__login-btn { border-radius: 20px; padding: 5px 16px; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.22); transition: background 0.2s, border-color 0.2s, box-shadow 0.2s; }.ecb-topbar__login-btn:hover { background: rgb(22, 131, 255); border-color: rgb(22, 131, 255); box-shadow: rgba(22, 131, 255, 0.45) 0px 3px 12px; color: rgb(255, 255, 255); }.ecb-topbar__phone { font-size: 15.5px; font-weight: 800; letter-spacing: 0.8px; color: rgb(255, 255, 255); transition: color 0.2s, text-shadow 0.2s; }.ecb-topbar__phone:hover { color: rgb(77, 163, 255); text-shadow: rgba(22, 131, 255, 0.4) 0px 0px 12px; }.ecb-topbar__social-link { width: 30px; height: 30px; border-radius: 50%; background: rgba(255, 255, 255, 0.08); transition: background 0.2s, transform 0.2s, box-shadow 0.2s; }.ecb-topbar__social-link:hover { transform: translateY(-2px); box-shadow: rgba(0, 0, 0, 0.25) 0px 4px 10px; }.ecb-topbar__social-link[aria-label=\"Instagram\"]:hover { background: rgb(225, 48, 108); }.ecb-topbar__social-link[aria-label=\"TikTok\"]:hover { background: rgb(1, 1, 1); }.ecb-topbar__social-link[aria-label=\"Facebook\"]:hover { background: rgb(24, 119, 242); }.ecb-topbar__social-link[aria-label=\"YouTube\"]:hover { background: rgb(255, 0, 0); }.ecb-topbar__social-link[aria-label=\"X (Twitter)\"]:hover { background: rgb(20, 23, 26); }.ecb-midbar { background: rgb(255, 255, 255); border-bottom: 1px solid rgb(226, 234, 244); box-shadow: rgba(0, 0, 0, 0.06) 0px 3px 16px; }.ecb-midbar__logo-img { height: 80px; transition: transform 0.25s, opacity 0.2s; }.ecb-midbar__logo:hover .ecb-midbar__logo-img { transform: scale(1.03); opacity: 0.92; }.ecb-midbar__search { border-radius: 50px; border: 1.5px solid rgb(208, 217, 232); height: 48px; background: rgb(245, 248, 252); transition: border-color 0.25s, box-shadow 0.25s, background 0.25s; max-width: 520px; }.ecb-midbar__search:focus-within { border-color: rgb(22, 131, 255); box-shadow: rgba(22, 131, 255, 0.12) 0px 0px 0px 4px, rgba(22, 131, 255, 0.1) 0px 4px 16px; background: rgb(255, 255, 255); }.ecb-midbar__search-icon { padding: 0px 10px 0px 18px; color: rgb(143, 168, 196); }.ecb-midbar__search-btn { border-radius: 0px 50px 50px 0px; width: 52px; background: rgb(22, 131, 255); transition: background 0.2s, transform 0.15s; }.ecb-midbar__search-btn:hover { background: rgb(13, 110, 224); transform: scale(1.04); }.ecb-midbar__action-link { border-radius: 10px; padding: 8px 16px; transition: color 0.2s, background 0.2s, transform 0.2s, box-shadow 0.2s; }.ecb-midbar__action-link:hover { color: rgb(22, 131, 255); background: rgb(238, 244, 255); transform: translateY(-2px); box-shadow: rgba(22, 131, 255, 0.13) 0px 4px 14px; }.ecb-midbar__action-label { font-size: 11.5px; font-weight: 700; letter-spacing: 0.2px; text-transform: uppercase; }.ecb-midbar__badge { font-size: 9.5px; font-weight: 800; min-width: 17px; height: 17px; border: 2px solid rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.18) 0px 1px 4px; }.ecb-navbar { background: rgb(255, 255, 255); border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; position: relative; }.ecb-navbar::after { content: \"\"; position: absolute; bottom: 0px; left: 0px; right: 0px; height: 3px; background: linear-gradient(90deg, rgb(22, 131, 255) 0%, rgb(10, 173, 255) 40%, rgb(22, 131, 255) 100%) 0% 0% / 200% 100%; animation: 4s linear 0s infinite normal none running ecb-shimmer; }@keyframes ecb-shimmer { \n  0% { background-position: 200% center; }\n  100% { background-position: -200% center; }\n}.ecb-navbar__all-cats-btn { background: linear-gradient(135deg, rgb(22, 131, 255) 0%, rgb(10, 109, 232) 100%); padding: 0px 26px; font-size: 14.5px; font-weight: 700; letter-spacing: 0.3px; gap: 10px; border-radius: 30px; transition: background 0.25s, box-shadow 0.25s, transform 0.15s; box-shadow: rgba(22, 131, 255, 0.4) 0px 4px 16px; min-height: 42px; height: auto; margin: 5px 0px; }.ecb-navbar__all-cats-btn:hover, .ecb-navbar__all-cats-btn[aria-expanded=\"true\"] { background: linear-gradient(135deg, rgb(13, 110, 224) 0%, rgb(8, 89, 198) 100%); box-shadow: rgba(22, 131, 255, 0.5) 0px 6px 22px; transform: translateY(-1px); }.ecb-navbar__cat-dropdown { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 12px; box-shadow: rgba(0, 0, 0, 0.14) 0px 12px 40px, rgba(0, 0, 0, 0.06) 0px 2px 8px; padding: 10px 0px; min-width: 260px; animation: 0.18s ease 0s 1 normal none running ecb-dropdown-in; }@keyframes ecb-dropdown-in { \n  0% { opacity: 0; transform: translateY(-8px); }\n  100% { opacity: 1; transform: translateY(0px); }\n}.ecb-navbar__cat-item { padding: 11px 24px; font-size: 14px; font-weight: 500; color: rgb(26, 40, 64); display: flex; align-items: center; gap: 8px; transition: background 0.15s, color 0.15s, padding-left 0.15s; }.ecb-navbar__cat-item::before { content: \"\"; display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: rgb(22, 131, 255); opacity: 0; transition: opacity 0.15s; flex-shrink: 0; }.ecb-navbar__cat-item:hover { background: rgb(240, 246, 255); color: rgb(22, 131, 255); padding-left: 28px; }.ecb-navbar__cat-item:hover::before { opacity: 1; }.ecb-navbar__container { min-height: 52px; }.ecb-navbar__list { gap: 2px; padding: 0px 12px; }.ecb-navbar__link { position: relative; padding: 16px 15px; font-size: 14px; font-weight: 600; color: rgb(44, 62, 87); letter-spacing: 0.15px; border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; transition: color 0.2s; }.ecb-navbar__link::after { content: \"\"; position: absolute; bottom: 0px; left: 50%; right: 50%; height: 3px; background: rgb(22, 131, 255); border-radius: 2px 2px 0px 0px; transition: left 0.22s, right 0.22s; }.ecb-navbar__link:hover, .ecb-navbar__item--active .ecb-navbar__link { color: rgb(22, 131, 255); }.ecb-navbar__link:hover::after, .ecb-navbar__item--active .ecb-navbar__link::after { left: 8px; right: 8px; }.ecb-navbar__link--deals { background: linear-gradient(135deg, rgb(232, 25, 26) 0%, rgb(196, 17, 18) 100%); border-radius: 6px; padding: 8px 18px; font-weight: 800; font-size: 13.5px; letter-spacing: 0.5px; text-transform: uppercase; box-shadow: rgba(232, 25, 26, 0.35) 0px 2px 10px; transition: transform 0.2s, box-shadow 0.2s, background 0.2s; animation: 2.8s ease-in-out 0s infinite normal none running ecb-deals-pulse; color: rgb(255, 255, 255) !important; }.ecb-navbar__link--deals::after { display: none; }.ecb-navbar__link--deals:hover { background: linear-gradient(135deg, rgb(196, 17, 18) 0%, rgb(163, 14, 15) 100%); transform: scale(1.05); box-shadow: rgba(232, 25, 26, 0.5) 0px 4px 18px; animation: auto ease 0s 1 normal none running none; }@keyframes ecb-deals-pulse { \n  0%, 100% { box-shadow: rgba(232, 25, 26, 0.35) 0px 2px 10px; }\n  50% { box-shadow: rgba(232, 25, 26, 0.6) 0px 4px 20px; }\n}}\n:root { --sb-accent: #1683ff; --sb-accent-light: #e8f1ff; --sb-accent-rgb: 22, 131, 255; --sb-dark: #0c1a2e; --sb-dark-mid: #152947; --sb-text: #374151; --sb-muted: #6b7a90; --sb-border: #e8edf5; --sb-radius: 18px; --sb-width: 268px; --sb-transitio