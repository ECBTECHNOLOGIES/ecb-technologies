  `.ecb-btn-outline{${btnSecondary};height:46px!important}`,
  `.ecb-checkbox__box{border-color:${T.ink}!important;border-radius:4px!important}`,
  `.ecb-trust-badge{background:${T.page}!important;color:${T.ink}!important;${label};font-size:9.5px!important;border:1px solid ${T.hair}!important}`,
  `.ecb-trust-badge svg{color:${T.ink}!important}`,

  // ---------- declutter (fewer, calmer elements, like nothing.tech) ----------
  // Header: no top bar (address/hours/phone are in Visit and the footer; agent
  // and rider logins move to the footer), icons only, account + cart only.
  `.ecb-topbar{display:none!important}`,
  `.ecb-midbar__action-label{display:none!important}`,
  `.ecb-midbar__actions>.ecb-midbar__action-item:nth-child(2),.ecb-midbar__action-item:has(a[href*="compare"]){display:none!important}`,
  `@media (max-width:991px){.ecb-midbar__inner{display:flex!important;flex-wrap:wrap!important;align-items:center!important;row-gap:10px!important}` +
    `.ecb-midbar__mobile-toggle{order:0}.ecb-midbar__logo{order:1;flex:1 1 auto;justify-content:center!important}` +
    `.ecb-midbar__actions{order:2;margin-left:auto!important;width:auto!important;flex:0 0 auto!important}` +
    `.ecb-midbar__actions>.ecb-midbar__action-item:first-child{display:none!important}` +
    `.ecb-midbar__search{order:3;flex:1 1 100%!important;width:100%!important}}`,
  `@media (max-width:767px){.ecb-seo-intro p{font-size:13px!important}}`,
  `.ecb-midbar__actions{gap:18px!important}`,
  // Menu: six links, centred; the rest live in "All categories" and the footer.
  `.ecb-navbar__item:has(a[href*="search=tablets"]),.ecb-navbar__item:has(a[href*="search=cctv"]),.ecb-navbar__item:has(a[href*="search=electronics"]),.ecb-navbar__item:has(a[href$="/contact"]){display:none!important}`,
  `@media (min-width:992px){.ecb-navbar__container{justify-content:center!important;gap:28px!important}.ecb-navbar__list{gap:6px!important}}`,
  `.ecb-navbar__all-cats-btn{background:transparent!important;color:${T.ink}!important;border:1px solid ${T.ink}!important}`,
  `.ecb-navbar__all-cats-btn svg,.ecb-navbar__all-cats-btn .ecb-navbar__caret{color:${T.ink}!important}`,
  // Hero: headline + one button.
  `.ecb-hero-badges,.ecb-hero-badge-corner{display:none!important}`,
  // Home intro: centred, quieter, two actions.
  `.ecb-seo-intro .container{text-align:center;padding-top:48px!important;padding-bottom:40px!important}`,
  `.ecb-seo-intro p{margin-left:auto!important;margin-right:auto!important;max-width:720px!important;font-size:14px!important}`,
  `.ecb-seo-cta{justify-content:center!important}`,
  `.ecb-seo-cta .ecb-cta-shop{display:none!important}`,
  // Sections removed: brands row, repeated "Unique selections", "Why shop" grid,
  // trust strip, empty footer map, social icons (they link nowhere yet).
  `.ecb-brands-section,.ecb-uniq-section,.ecb-why-section,.ecb-trust-bar,.ecb-footer-map{display:none!important}`,
  // Featured: 8 products in a calm 4-column grid, no tabs; "View all" for the rest.
  `.ecb-featured-tabs{display:none!important}`,
  `.ecb-fp-grid>.ecb-fp-item:nth-child(n+9){display:none!important}`,
  `@media (min-width:992px){.ecb-featured-section .ecb-fp-grid{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:16px!important}}`,
  `.ecb-featured-section .ecb-fp-arrow{display:none!important}`,
  // Section titles centred with breathing room.
  `.ecb-featured-header-row1,.ecb-bestsell-header{flex-direction:column!important;align-items:center!important;gap:14px!important;text-align:center!important}`,
  `.ecb-bestsell-controls{justify-content:center!important}`,
  `.ecb-featured-section,.ecb-bestsell-section,.ecb-promos-section{padding-top:56px!important;padding-bottom:16px!important}`,
  `@media (max-width:767px){.ecb-featured-section,.ecb-bestsell-section,.ecb-promos-section{padding-top:36px!important}}`,
  // Product cards: no wishlist hearts, no "NEW" on every item.
  `.ecb-fp-wish,.ecb-bs-wish,.ecb-uniq-wish,.ecb-cat-list-wish,.ecb-fp-badge--new,.ecb-bs-badge--new,.ecb-uniq-badge--new{display:none!important}`,
  `.ecb-fp-card,.ecb-bs-card{padding-bottom:14px!important}`,
  // Visit section: one quiet card.
  `.ecb-visit-section{padding:56px 0!important}`,
  `.ecb-visit-detail-icon{display:none!important}`,
  `.ecb-visit-open-badge{display:none!important}`,
  // Footer: three columns, no repeated contact block icons.
  `@media (min-width:992px){.ecb-footer-grid{grid-template-columns:1.2fr 1fr 1fr 1fr!important}}`,
  `.ecb-footer-contact-row svg,.ecb-footer-address-block svg{display:none!important}`,
  `.ecb-footer-bottom-links a{margin-left:18px!important}`,
  // Product page: drop the marketplace extras.
  `.ecb-pd-meta-row .ecb-pd-stars,.ecb-pd-rating-val,.ecb-pd-rating-count,.ecb-pd-actions,.ecb-pd-share,.ecb-pd-seller,.ecb-pd-stock-count,.ecb-pd-img-wish{display:none!important}`,
  `.ecb-pd-meta-row{justify-content:flex-start!important}`,
  `.ecb-pd-trust-strip{border:0!important;background:transparent!important}`,
  // Category page: no list/grid switch, no "recent products".
  `.ecb-cat-view-toggle{display:none!important}`,
  // Mobile menu: no contact strip duplication.
  `.ecb-mm-contact-strip{display:none!important}`,

  // ---------- nothing.tech pass 2: full-bleed hero, fewer words, flat product UI ----------
  // Hero: the photo covers the whole section, edge to edge; text sits bottom-left.
  `.ecb-hero-outer{padding:0!important;margin:0!important}`,
  `.ecb-hero-wrapper,.ecb-hero-slide{border-radius:0!important}`,
  `.ecb-hero-slide,.ecb-hero-inner{min-height:min(78vh,760px)!important}`,
  `@media (max-width:767px){.ecb-hero-slide,.ecb-hero-inner{min-height:72vh!important}.ecb-hero-slide.active{display:block!important}}`,
  `.ecb-hero-img-bg{width:100%!important;left:0!important;right:0!important;opacity:1!important;-webkit-mask-image:none!important;mask-image:none!important;background-size:cover!important;background-position:center 30%!important;filter:brightness(.92) saturate(.9)!important}`,
  `@media (max-width:767px){.ecb-hero-img-bg{background-position:20% center!important}}`,
  `.ecb-hero-overlay,.ecb-hero-overlay[class]{background:linear-gradient(0deg,rgba(0,0,0,.72) 0%,rgba(0,0,0,.35) 32%,rgba(0,0,0,0) 62%)!important}`,
  `.ecb-hero-inner{display:flex!important;align-items:flex-end!important;padding-bottom:64px!important;padding-top:0!important}`,
  `@media (max-width:767px){.ecb-hero-inner{padding-bottom:44px!important}}`,
  `.ecb-hero-content{max-width:none!important;padding:0!important}`,
  `.ecb-hero-title{font-size:80px!important;line-height:1.04!important;margin:0 0 26px!important;max-width:none!important}`,
  `@media (max-width:1199px){.ecb-hero-title{font-size:60px!important}}`,
  `@media (max-width:767px){.ecb-hero-title{font-size:36px!important;margin-bottom:18px!important}}`,
  `.ecb-hero-eyebrow{color:${T.canvas}!important;opacity:.85}`,
  `.ecb-hero-dots{bottom:22px!important}`,
  `.ecb-cats-title{${display};font-size:34px!important;text-align:center;margin:0 0 28px!important;color:${T.ink}!important}`,
  `@media (max-width:767px){.ecb-cats-title{font-size:24px!important;margin-bottom:18px!important}}`,
  `.ecb-cats-strip{padding-top:64px!important}`,
  `.ecb-pd-local-qa{padding-top:40px;padding-bottom:8px;max-width:860px}.ecb-pd-local-qa h2{${display};font-size:24px!important;margin:0 0 14px!important}.ecb-pd-local-qa h3{font-size:16px!important;margin:16px 0 4px!important;font-weight:500!important}.ecb-pd-local-qa p{margin:0;color:#333;line-height:1.6}.ecb-pd-local-qa p:last-child{margin-top:16px}.ecb-pd-local-qa a{${label};font-size:11px!important;color:${T.ink}!important;text-decoration:underline!important}`,
  `.ecb-cats-all{text-align:center;margin:22px 0 0!important}.ecb-cats-all a{${label};font-size:11px!important;color:${T.ink}!important;text-decoration:underline!important}`,
  `.gs-pagination li span{display:flex;width:49px;height:48px;align-items:center;justify-content:center;color:#bbb}`,
  `@media (max-width:767px){.ecb-cats-strip{padding-top:40px!important}}`,
  `h1.ecb-hero-eyebrow{font-size:11px!important;line-height:1.4!important;margin:0!important;font-weight:400!important}`,
  // Home: categories, 8 products, visit. Promos and best sellers go.
  `.ecb-promos-section,.ecb-bestsell-section{display:none!important}`,
  `.ecb-seo-intro .container{padding-top:56px!important;padding-bottom:24px!important}`,
  `.ecb-seo-intro h1{font-size:30px!important}`,
  `@media (max-width:767px){.ecb-seo-intro h1{font-size:22px!important}}`,
  `.ecb-seo-cta .ecb-cta-shop{display:inline-flex!important}`,
  `.ecb-visit-eyebrow,.ecb-visit-tagline,.ecb-visit-detail-sub{display:none!important}`,
  `.ecb-visit-detail-item:has(.ecb-visit-detail-sub) .ecb-visit-detail-sub{display:none!important}`,
  `.ecb-visit-info-card{max-width:760px;margin:0 auto!important}`,
  `.ecb-visit-title{text-align:center}`,
  // Product tiles: image, name in dot-matrix, price. The tile is the link.
  `.ecb-fp-footer,.ecb-bs-footer,.ecb-uniq-footer{display:none!important}`,
  `.ecb-fp-card,.ecb-bs-card{padding:18px 14px 22px!important}`,
  `.ecb-fp-name,.ecb-bs-name{font-family:${T.dot}!important;font-weight:700!important;font-size:16px!important;letter-spacing:.02em!important;line-height:1.25!important;text-transform:uppercase!important}`,
  `.ecb-fp-price,.ecb-bs-price{font-size:13px!important;font-weight:400!important}`,
  `.ecb-fp-img-wrap img{transition:transform .35s ease}.ecb-fp-card:hover .ecb-fp-img-wrap img{transform:scale(1.04)}`,
  // Product page: flat, big image, dot-matrix name, mono price.
  `.ecb-pd-trail{display:none!important}`,
  `.ecb-pd-trust-strip{display:none!important}`,
  `.ecb-pd-info{background:transparent!important;border:0!important;padding-top:8px!important}`,
  `.ecb-pd-name{font-family:${T.dot}!important;font-weight:800!important;text-transform:uppercase!important;font-size:34px!important;line-height:1.12!important;letter-spacing:.01em!important}`,
  `@media (max-width:767px){.ecb-pd-name{font-size:24px!important}}`,
  `.ecb-pd-price,#sizeprice{font-family:${T.mono}!important;font-weight:400!important;font-size:22px!important;letter-spacing:.02em!important}`,
  `.ecb-pd-divider{display:none!important}`,
  `.ecb-pd-meta-list{margin:14px 0!important}`,
  `.ecb-pd-main-img-wrap{min-height:min(60vh,560px)!important;display:flex!important;align-items:center!important;justify-content:center!important}`,
  `.ecb-pd-tab-nav{display:none!important}`,
  `.ecb-pd-desc-header{display:none!important}`,
  `.ecb-pd-description-wrap{background:transparent!important;border:0!important}`,
  `.ecb-pd-intro{padding-left:0!important;padding-right:0!important}`,
  `.ecb-pd-spec-table{border:1px solid ${T.hair}!important;border-radius:8px!important;overflow:hidden}`,
  // Category page: the intro is one quiet line.
  `.ecb-seo-cat-intro p{${label};font-size:11px!important;line-height:1.8!important}`,
  `.ecb-seo-cat-intro p a{text-decoration:underline!important}`,
  // Footer (nothing.tech pattern).
  `.ecb-footer{background-color:${T.ink}!important;background-image:radial-gradient(circle,#3a3a3a 1px,transparent 1.5px)!important;background-size:160px 160px!important}`,
  `.ecb-footer-main{background:transparent!important;padding:72px 0 28px!important}`,
  `.ecb-footer-newsletter{background:transparent!important;border:0!important;border-bottom:1px solid #1f1f1f!important}`,
  `.ecb-newsletter-text p,.ecb-newsletter-text svg,.ecb-footer-newsletter svg{display:none!important}`,
  `.nf-wrap{max-width:1320px;margin:0 auto;padding:0 24px}`,
  `.nf-big{display:flex;flex-direction:column;align-items:center;gap:6px;margin-bottom:56px}`,
  `.nf-big a{${display};color:${T.canvas}!important;font-size:56px!important;text-decoration:none!important}`,
  `.nf-big a:hover{opacity:.7}`,
  `@media (max-width:767px){.nf-big a{font-size:34px!important}}`,
  `.nf-tiles{max-width:460px;margin:0 auto 64px;display:flex;flex-direction:column;gap:4px}`,
  `.nf-tile{display:flex;align-items:center;justify-content:space-between;background:#111!important;border-radius:8px;padding:20px 22px;color:${T.canvas}!important;text-decoration:none!important;${label};font-size:12px!important}`,
  `.nf-tile:hover{background:#1c1c1c!important}`,
  `.nf-tile svg{color:${T.canvas}!important;flex:0 0 auto}`,
  `.nf-bottom{display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;padding-top:24px}`,
  `.nf-links{display:flex;flex-wrap:wrap;gap:8px 28px}`,
  `.nf-links a{${label};font-size:12px!important;color:${T.canvas}!important;text-decoration:none!important}`,
  `.nf-links a:hover{opacity:.7}`,
  `.nf-copy{${label};font-size:10px!important;color:#7a7a7a!important;margin:28px 0 0!important;text-align:left}`,

  // ---------- forms and misc ----------
  `.form-control,.nice-select{border-radius:6px!important;border-color:${T.hair}!important;box-shadow:none!important}`,
  `.form-control:focus{border-color:${T.ink}!important}`,
  `.template-btn,.btn-primary{${btnPrimary}}`,
  `#toast-container>div{border-radius:8px!important;box-shadow:none!important;${label};font-size:11px!important;opacity:1!important}`,
  `#toast-container>.toast-success,#toast-container>.toast-info{background-color:${T.ink}!important}`,
].join("");

