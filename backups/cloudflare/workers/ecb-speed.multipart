  `@media (max-width:1199.97px){.gs-breadcrumb-section .breadcrumb-title{font-size:44px!important}}`,
  `@media (max-width:767px){.gs-breadcrumb-section{padding:32px 0 12px!important}.gs-breadcrumb-section .breadcrumb-title{font-size:28px!important}}`,
  `.gs-breadcrumb-section .bread-menu,.gs-breadcrumb-section .bread-menu li,.gs-breadcrumb-section .bread-menu li a{${label};font-size:11px!important;color:${T.muted}!important}`,
  `.gs-breadcrumb-section .bread-menu li::after{color:${T.muted}!important;content:"/"!important}`,
  `.gs-breadcrumb-section .bread-menu li:last-child::after{content:""!important}`,
  `.gs-breadcrumb-section .bread-menu li a:hover{color:${T.ink}!important}`,
