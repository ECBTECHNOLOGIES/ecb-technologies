  `.ecb-footer-map{border:1px solid #2a2a2a!important;border-radius:8px!important;filter:grayscale(1)}`,
  `.ecb-footer-bottom{border-top:1px solid #1f1f1f!important}`,
  `.ecb-footer svg,.ecb-footer i{color:${T.canvas}!important}`,

  // ---------- page header (category, product, info pages) ----------
  `.gs-breadcrumb-section{background:transparent!important;background-image:none!important;padding:56px 0 24px!important;min-height:0!important}`,
  `.gs-breadcrumb-section::before,.gs-breadcrumb-section::after{display:none!important}`,
