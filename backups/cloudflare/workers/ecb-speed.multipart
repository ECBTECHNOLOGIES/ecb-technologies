67px){.ecb-cat-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }}\n@media (max-width: 400px){.ecb-cat-grid { grid-template-columns: 1fr; }}\n.ecb-cat-list { display: flex; flex-direction: column; gap: 12px; margin-bottom: 28px; }\n.ecb-cat-list-card { position: relative; display: flex; align-items: stretch; gap: 0px; background: rgb(255, 255, 255); border: 1.5px solid rgb(224, 232, 240); border-radius: 12px; overflow: hidden; transition: box-shadow 0.22s, border-color 0.22s, transform 0.22s; }\n.ecb-cat-list-card:hover { box-shadow: rgba(22, 131, 255, 0.13) 0px 8px 28px; border-color: rgb(197, 216, 245); transform: translateY(-2px); }\n.ecb-cat-list-badge { position: absolute; top: 12px; left: 12px; padding: 3px 9px; border-radius: 5px; font-size: 10.5px; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; z-index: 2; }\n.ecb-cat-list-badge--new { background: rgb(22, 131, 255); color: rgb(255, 255, 255); }\n.ecb-cat-list-img { position: relative; width: 180px; flex-shrink: 0; background: linear-gradient(145deg, rgb(240, 244, 251), rgb(232, 238, 247)); display: flex; align-items: center; justify-content: center; padding: 16px; border-right: 1.5px solid rgb(232, 238, 245); }\n.ecb-cat-list-img img { max-width: 100%; max-height: 150px; object-fit: contain; display: block; transition: transform 0.25s; }\n.ecb-cat-list-card:hover .ecb-cat-list-img img { transform: scale(1.05); }\n.ecb-cat-list-wish { position: absolute; top: 10px; right: 10px; width: 30px; height: 30px; border-radius: 50%; background: rgba(255, 255, 255, 0.9); border: 1.5px solid rgb(226, 234, 243); display: flex; align-items: center; justify-content: center; text-decoration: none; z-index: 2; transition: border-color 0.2s, background 0.2s; }\n.ecb-cat-list-wish:hover { border-color: rgb(232, 25, 26); background: rgb(255, 245, 245); }\n.ecb-cat-list-wish svg { width: 14px; height: 14px; }\n.ecb-cat-list-body { flex: 1 1 0%; padding: 18px 20px; display: flex; flex-direction: colum