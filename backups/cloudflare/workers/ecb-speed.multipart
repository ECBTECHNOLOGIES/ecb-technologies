  `.ecb-visit-open-dot{background:${T.ink}!important}`,
  `.ecb-trust-bar{background:${T.ink}!important;border:0!important}`,
  `.ecb-trust-icon{background:transparent!important;border:1px solid rgba(255,255,255,.3)!important}`,
  `.ecb-trust-icon svg,.ecb-trust-bar svg{color:${T.canvas}!important;stroke:currentColor}`,
  `.ecb-trust-main{${label};font-size:11px!important;color:${T.canvas}!important}`,
  `.ecb-trust-sub{color:#9c9c9c!important;font-size:12px!important}`,
