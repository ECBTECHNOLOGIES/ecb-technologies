  `.ecb-pd-seller-btn{${btnSecondary}}`,
  `.ecb-pd-tab-nav{background:transparent!important;border:0!important;box-shadow:none!important;border-bottom:1px solid ${T.hair}!important}`,
  `.ecb-pd-tab{${label};font-size:11px!important;color:${T.muted}!important;background:transparent!important;border-radius:0!important;box-shadow:none!important}`,
  `.ecb-pd-tab.active{color:${T.ink}!important;box-shadow:inset 0 -2px 0 ${T.ink}!important;background:transparent!important}`,
