d #e3e8f0\">KSh 59,500</td><td style=\"padding:8px 10px;border-bottom:1px solid #e3e8f0\">KSh 315,500</td><td style=\"padding:8px 10px;border-bottom:1px solid #e3e8f0\">XPS (26), Latitude (21), Precision (3)</td></tr><tr><td style=\"padding:8px 10px;border-bottom:1px solid #e3e8f0\">Lenovo</td><td style=\"padding:8px 10px;border-bottom:1px solid #e3e8f0\">94</td><td style=\"padding:8px 10px;border-bottom:1px solid #e3e8f0\">KSh 16,000</td><td style=\"padding:8px 10px;border-bottom:1px solid #e3e8f0\">KSh 37,000</td><td style=\"padding:8px 10px;border-bottom:1px solid #e3e8f0\">KSh 285,000</td><td style=\"padding:8px 10px;border-bottom:1px solid #e3e8f0\">Thinkpad (77), Ideapad (5), Yoga (2)</td></tr></tbody></table><h2>Cheapest of each brand</h2><ul><li><strong>HP:</strong> <a href=\"https://www.ecbtechkenya.com/item/hp-probook-11e-g2-celeron-4gb-256-gb-ssd-x360-touchscreen-amt48830ud\">HP PROBOOK 11E G2 CELERON 4GB 256 GB SSD X360 Touchscreen</a> – KSh 21,000</li><li><strong>Dell:</strong> <a href=\"https://www.ecbtechkenya.com/item/dell-latitude-e7240-i5-4th-gen-8-gb-ram-256-nontouch-axv2821aqd\">DELL LATITUDE E7240 I5 4TH GEN 8 GB RAM 256 NONTOUCH</a> – KSh 21,000</li><li><strong>Lenovo:</strong> <a href=\"https://www.ecbtechkenya.com/item/lenovo-thinkpad-11e-price-in-kenya-intel-celeron-4gb-ram-128gb-ssd-intel-hd-graphics-116-hd-5dp4502q7h\">Lenovo ThinkPad 11e Price in Kenya – Intel Celeron, 4GB RAM, 128GB SSD, Intel HD Graphics, 11.6&quot; HD</a> – KSh 16,000</li></ul><h2>Which series is which?</h2><ul><li><strong>HP EliteBook and ProBook, Dell Latitude, Lenovo ThinkPad</strong> are business laptop lines, built for daily office use.</li><li><strong>HP OMEN and Victus</strong> are HP's gaming laptops; see <a href=\"https://www.ecbtechkenya.com/category/gaming\">gaming</a>.</li><li><strong>Dell XPS, HP Spectre and Envy, Lenovo Yoga</strong> are thin and light premium laptops.</li><li><strong>HP ZBook and Dell Precision</strong> are workstations for design, engin