opbar__social-link { width: 30px; height: 30px; border-radius: 50%; background: rgba(255, 255, 255, 0.08); transition: background 0.2s, transform 0.2s, box-shadow 0.2s; }.ecb-topbar__social-link:hover { transform: translateY(-2px); box-shadow: rgba(0, 0, 0, 0.25) 0px 4px 10px; }.ecb-topbar__social-link[aria-label=\"Instagram\"]:hover { background: rgb(225, 48, 108); }.ecb-topbar__social-link[aria-label=\"TikTok\"]:hover { background: rgb(1, 1, 1); }.ecb-topbar__social-link[aria-label=\"Facebook\"]:hover { background: rgb(24, 119, 242); }.ecb-topbar__social-link[aria-label=\"YouTube\"]:hover { background: rgb(255, 0, 0); }.ecb-topbar__social-link[aria-label=\"X (Twitter)\"]:hover { background: rgb(20, 23, 26); }.ecb-midbar { background: rgb(255, 255, 255); border-bottom: 1px solid rgb(226, 234, 244); box-shadow: rgba(0, 0, 0, 0.06) 0px 3px 16px; }.ecb-midbar__logo-img { height: 80px; transition: transform 0.25s, opacity 0.2s; }.ecb-midbar__logo:hover .ecb-midbar__logo-img { transform: scale(1.03); opacity: 0.92; }.ecb-midbar__search { border-radius: 50px; border: 1.5px solid rgb(208, 217, 232); height: 48px; background: rgb(245, 248, 252); transition: border-color 0.25s, box-shadow 0.25s, background 0.25s; max-width: 520px; }.ecb-midbar__search:focus-within { border-color: rgb(22, 131, 255); box-shadow: rgba(22, 131, 255, 0.12) 0px 0px 0px 4px, rgba(22, 131, 255, 0.1) 0px 4px 16px; background: rgb(255, 255, 255); }.ecb-midbar__search-icon { padding: 0px 10px 0px 18px; color: rgb(143, 168, 196); }.ecb-midbar__search-btn { border-radius: 0px 50px 50px 0px; width: 52px; background: rgb(22, 131, 255); transition: background 0.2s, transform 0.15s; }.ecb-midbar__search-btn:hover { background: rgb(13, 110, 224); transform: scale(1.04); }.ecb-midbar__action-link { border-radius: 10px; padding: 8px 16px; transition: color 0.2s, background 0.2s, transform 0.2s, box-shadow 0.2s; }.ecb-midbar__action-link:hover { color: rgb(22, 131, 255); background: rgb(238, 244, 255); transform: translateY(-2px); box-shadow: rgba(22, 131, 255, 0.13) 0px 4px 14px; }.ecb-midbar__action-label { font-size: 11.5px; font-weight: 700; letter-spacing: 0.2px; text-transform: uppercase; }.ecb-midbar__badge { font-size: 9.5px; font-weight: 800; min-width: 17px; height: 17px; border: 2px solid rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.18) 0px 1px 4px; }.ecb-navbar { background: rgb(255, 255, 255); border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; position: relative; }.ecb-navbar::after { content: \"\"; position: absolute; bottom: 0px; left: 0px; right: 0px; height: 3px; background: linear-gradient(90deg, rgb(22, 131, 255) 0%, rgb(10, 173, 255) 40%, rgb(22, 131, 255) 100%) 0% 0% / 200% 100%; animation: 4s linear 0s infinite normal none running ecb-shimmer; }@keyframes ecb-shimmer { \n  0% { background-position: 200% center; }\n  100% { background-position: -200% center; }\n}.ecb-navbar__all-cats-btn { background: linear-gradient(135deg, rgb(22, 131, 255) 0%, rgb(10, 109, 232) 100%); padding: 0px 26px; font-size: 14.5px; font-weight: 700; letter-spacing: 0.3px; gap: 10px; border-radius: 30px; transition: background 0.25s, box-shadow 0.25s, transform 0.15s; box-shadow: rgba(22, 131, 255, 0.4) 0px 4px 16px; min-height: 42px; height: auto; margin: 5px 0px; }.ecb-navbar__all-cats-btn:hover, .ecb-navbar__all-cats-btn[aria-expanded=\"true\"] { background: linear-gradient(135deg, rgb(13, 110, 224) 0%, rgb(8, 89, 198) 100%); box-shadow: rgba(22, 131, 255, 0.5) 0px 6px 22px; transform: translateY(-1px); }.ecb-navbar__cat-dropdown { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 12px; box-shadow: rgba(0, 0, 0, 0.14) 0px 12px 40px, rgba(0, 0, 0, 0.06) 0px 2px 8px; padding: 10px 0px; min-width: 260px; animation: 0.18s ease 0s 1 normal none running ecb-dropdown-in; }@keyframes ecb-dropdown-in { \n  0% { opacity: 0; transform: translateY(-8px); }\n  100% { opacity: 1; transform: translateY(0px); }\n}.ecb-navbar__cat-item { padding: 11px 24px; font-size: 14px; font-weight: 500; color: rgb(26, 40, 64); display: flex; align-items: center; gap: 8px; transition: background 0.15s, color 0.15s, padding-left 0.15s; }.ecb-navbar__cat-item::before { content: \"\"; display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: rgb(22, 131, 255); opacity: 0; transition: opacity 0.15s; flex-shrink: 0; }.ecb-navbar__cat-item:hover { background: rgb(240, 246, 255); color: rgb(22, 131, 255); padding-left: 28px; }.ecb-navbar__cat-item:hover::before { opacity: 1; }.ecb-navbar__container { min-height: 52px; }.ecb-navbar__list { gap: 2px; padding: 0px 12px; }.ecb-navbar__link { position: relative; padding: 16px 15px; font-size: 14px; font-weight: 600; color: rgb(44, 62, 87); letter-spacing: 0.15px; border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; transition: color 0.2s; }.ecb-navbar__link::after { content: \"\"; position: absolute; bottom: 0px; left: 50%; right: 50%; height: 3px; background: rgb(22, 131, 255); border-radius: 2px 2px 0px 0px; transition: left 0.22s, right 0.22s; }.ecb-navbar__link:hover, .ecb-navbar__item--active .ecb-navbar__link { color: rgb(22, 131, 255); }.ecb-navbar__link:hover::after, .ecb-navbar__item--active .ecb-navbar__link::after { left: 8px; right: 8px; }.ecb-navbar__link--deals { background: linear-gradient(135deg, rgb(232, 25, 26) 0%, rgb(196, 17, 18) 100%); border-radius: 6px; padding: 8px 18px; font-weight: 800; font-size: 13.5px; letter-spacing: 0.5px; text-transform: uppercase; box-shadow: rgba(232, 25, 26, 0.35) 0px 2px 10px; transition: transform 0.2s, box-shadow 0.2s, background 0.2s; animation: 2.8s ease-in-out 0s infinite normal none running ecb-deals-pulse; color: rgb(255, 255, 255) !important; }.ecb-navbar__link--deals::after { display: none; }.ecb-navbar__link--deals:hover { background: linear-gradient(135deg, rgb(196, 17, 18) 0%, rgb(163, 14, 15) 100%); transform: scale(1.05); box-shadow: rgba(232, 25, 26, 0.5) 0px 4px 18px; animation: auto ease 0s 1 normal none running none; }@keyframes ecb-deals-pulse { \n  0%, 100% { box-shadow: rgba(232, 25, 26, 0.35) 0px 2px 10px; }\n  50% { box-shadow: rgba(232, 25, 26, 0.6) 0px 4px 20px; }\n}}\n.ecb-uniq-section { padding: 48px 0px 52px; background: rgb(255, 255, 255); position: relative; }\n.ecb-uniq-section::before, .ecb-uniq-section::after { content: \"\"; display: block; height: 1px; background: linear-gradient(90deg, transparent, rgb(226, 234, 243) 20%, rgb(226, 234, 243) 80%, transparent); position: absolute; left: 0px; right: 0px; }\n.ecb-uniq-section::before { top: 0px; }\n.ecb-uniq-section::after { bottom: 0px; }\n.ecb-uniq-header { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 28px; }\n.ecb-uniq-heading-group { display: flex; flex-direction: column; gap: 3px; }\n.ecb-uniq-eyebrow { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(22, 131, 255); }\n.ecb-uniq-title { font-size: 24px; font-weight: 800; color: rgb(26, 40, 64); margin: 0px; line-height: 1.2; }\n.ecb-uniq-subtitle { font-size: 13px; color: rgb(136, 150, 170); margin: 0px; }\n.ecb-uniq-nav { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }\n.ecb-uniq-arrow { width: 38px; height: 38px; border-radius: 50%; border: 1.5px solid rgb(221, 230, 240); background: rgb(255, 255, 255); color: rgb(26, 40, 64); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.15s; box-shadow: rgba(22, 60, 130, 0.06) 0px 2px 8px; }\n.ecb-uniq-arrow:hover { background: rgb(22, 131, 255); border-color: rgb(22, 131, 255); color: rgb(255, 255, 255); transform: scale(1.08); box-shadow: rgba(22, 131, 255, 0.28) 0px 4px 14px; }\n.ecb-uniq-dots-wrap { display: flex; align-items: center; }\n#uniqDotsWrap .slick-dots { position: static; align-items: center; gap: 5px; padding: 0px; margin: 0px; list-style: none; bottom: auto; display: flex !important; }\n#uniqDotsWrap .slick-dots li { width: auto; height: auto; margin: 0px; }\n#uniqDotsWrap .slick-dots li button { width: 7px; height: 7px; border-radius: 50%; background: rgb(200, 216, 234); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px; font-size: 0px; transition: background 0.2s, width 0.25s; }\n#uniqDotsWrap .slick-dots li button::before { display: none; }\n#uniqDotsWrap .slick-dots li.slick-active button { background: rgb(22, 131, 255); width: 22px; border-radius: 4px; }\n.ecb-uniq-viewall { display: inline-flex; align-items: center; gap: 5px; font-size: 12.5px; font-weight: 700; color: rgb(22, 131, 255); background: rgb(238, 244, 255); border: 1.5px solid rgb(200, 220, 255); padding: 7px 16px; border-radius: 20px; text-decoration: none; white-space: nowrap; transition: background 0.2s, border-color 0.2s, color 0.2s; margin-left: 4px; }\n.ecb-uniq-viewall:hover { background: rgb(22, 131, 255); border-color: rgb(22, 131, 255); color: rgb(255, 255, 255); }\n.ecb-uniq-slider { margin: 0px -9px; }\n.ecb-uniq-slider .slick-list { overflow: hidden; }\n.ecb-uniq-slider .slick-track { align-items: stretch; display: flex !important; }\n.ecb-uniq-slider .slick-slide { padding: 0px 9px; }\n.ecb-uniq-slider .slick-slide > div { height: 100%; }\n.ecb-uniq-slide { height: 100%; outline: none; }\n.ecb-uniq-card { position: relative; display: flex; flex-direction: column; height: 100%; background: rgb(255, 255, 255); border-radius: 14px; overflow: hidden; border: 1.5px solid rgb(232, 238, 245); box-shadow: rgba(22, 60, 130, 0.06) 0px 2px 12px; transition: transform 0.28s, box-shadow 0.28s, border-color 0.28s; }\n.ecb-uniq-card:hover { transform: translateY(-5px); box-shadow: rgba(22, 131, 255, 0.14) 0px 12px 36px; border-color: rgb(184, 208, 255); }\n.ecb-uniq-card::before { content: \"\"; position: absolute; top: 0px; left: 0px; right: 0px; height: 3px; background: linear-gradient(90deg, rgb(22, 131, 255), rgb(124, 58, 237)); transform: scaleX(0); transform-origin: left center; transition: transform 0.3s; z-index: 2; }\n.ecb-uniq-card:hover::before { transform: scaleX(1); }\n.ecb-uniq-img-wrap { position: relative; background: linear-gradient(145deg, rgb(244, 247, 252) 0%, rgb(234, 240, 248) 100%); height: 185px; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 16px; }\n.ecb-uniq-img-link { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }\n.ecb-uniq-img-wrap img { max-height: 148px; max-width: 100%; width: auto; height: auto; object-fit: contain; transition: transform 0.32s; }\n.ecb-uniq-card:hover .ecb-uniq-img-wrap img { transform: scale(1.07); }\n.ecb-uniq-badge { position: absolute; top: 10px; left: 10px; font-size: 10px; font-weight: 700; letter-spacing: 0.04em; padding: 3px 9px; border-radius: 20px; line-height: 1.4; z-index: 3; text-transform: uppercase; }\n.ecb-uniq-badge--new { background: rgb(22, 131, 255); color: rgb(255, 255, 255); }\n.ecb-uniq-wish { position: absolute; top: 10px; right: 10px; width: 30px; height: 30px; border-radius: 50%; background: rgb(255, 255, 255); border: 1.5px solid rgb(221, 230, 240); display: inline-flex; align-items: center; justify-content: center; z-index: 3; text-decoration: none; transition: border-color 0.2s, background 0.2s; box-shadow: rgba(22, 60, 130, 0.08) 0px 1px 5px; }\n.ecb-uniq-wish:hover { border-color: rgb(232, 25, 26); background: rgb(255, 245, 245); }\n.ecb-uniq-wish svg { width: 14px; height: 14px; }\n.ecb-uniq-body { padding: 14px 14px 0px; flex: 1 1 0%; display: flex; flex-direction: column; gap: 4px; }\n.ecb-uniq-name { font-size: 13.5px; font-weight: 700; color: rgb(26, 40, 64); text-decoration: none; line-height: 1.35; display: -webkit