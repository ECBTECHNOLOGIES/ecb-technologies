 flex; flex-direction: column; transform: translateX(-100%); transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1); overflow: hidden; box-shadow: rgba(12, 26, 46, 0.18) 6px 0px 40px; }\n.ecb-mm-header { display: flex; align-items: center; justify-content: space-between; padding: 0px 18px; height: 68px; background: rgb(255, 255, 255); border-bottom: 2px solid rgb(22, 131, 255); flex-shrink: 0; position: relative; }\n.ecb-mm-header::before { content: \"\"; position: absolute; left: 0px; top: 0px; bottom: 0px; width: 4px; background: linear-gradient(rgb(22, 131, 255) 0%, rgb(13, 110, 224) 100%); border-radius: 0px 2px 2px 0px; }\n.ecb-mm-logo-link { display: flex; align-items: center; height: 100%; padding: 10px 0px; }\n.ecb-mm-logo { height: 44px; width: auto; object-fit: contain; display: block; }\n.ecb-mm-close { color: rgb(12, 26, 46); cursor: pointer; padding: 6px; border-radius: 8px; transition: color 0.2s, background 0.2s, border-color 0.2s; flex-shrink: 0; border: 1.5px solid rgb(224, 232, 240); display: flex; align-items: center; justify-content: center; }\n.ecb-mm-close:hover { color: rgb(232, 25, 26); background: rgb(255, 240, 240); border-color: rgb(245, 184, 184); }\n.ecb-mm-search { padding: 12px 16px; background: rgb(247, 249, 252); border-bottom: 1px solid rgb(238, 242, 247); flex-shrink: 0; }\n.ecb-mm-search-inner { display: flex; align-items: center; gap: 8px; background: rgb(255, 255, 255); border: 1.5px solid rgb(208, 220, 234); border-radius: 10px; padding: 0px 6px 0px 12px; height: 40px; transition: border-color 0.2s; }\n.ecb-mm-search-inner:focus-within { border-color: rgb(22, 131, 255); }\n.ecb-mm-search-inner > svg { flex-shrink: 0; color: rgb(154, 172, 191); }\n.ecb-mm-search-inner input { flex: 1 1 0%; background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; outline: none; font-size: 13.5px; color: rgb(26, 40, 64); min-width: 0px; }\n.ecb-mm-search-inner input::placeholder { color: rgb(176, 190, 200); }\n.ecb-mm-search-inner button { flex-shrink: 0; background: rgb(22, 131, 255); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(255, 255, 255); width: 30px; height: 30px; border-radius: 7px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.2s; }\n.ecb-mm-search-inner button:hover { background: rgb(13, 110, 224); }\n.ecb-mm-tabs { display: flex; flex-shrink: 0; background: rgb(255, 255, 255); border-bottom: 2px solid rgb(238, 242, 247); }\n.ecb-mm-tab { flex: 1 1 0%; display: flex; align-items: center; justify-content: center; gap: 7px; padding: 12px 8px; background: none; border-width: medium medium 2px; border-style: none none solid; border-color: currentcolor currentcolor transparent; border-image: none; margin-bottom: -2px; color: rgb(107, 122, 153); font-size: 13px; font-weight: 600; cursor: pointer; transition: color 0.2s, border-color 0.2s; white-space: nowrap; }\n.ecb-mm-tab:hover { color: rgb(26, 40, 64); }\n.ecb-mm-tab.active { color: rgb(22, 131, 255); border-bottom-color: rgb(22, 131, 255); }\n.ecb-mm-tab svg { opacity: 0.6; }\n.ecb-mm-tab.active svg { opacity: 1; color: rgb(22, 131, 255); }\n.ecb-mm-panel { display: none; flex: 1 1 0%; overflow-y: auto; scrollbar-width: thin; scrollbar-color: rgb(208, 220, 234) transparent; background: rgb(255, 255, 255); }\n.ecb-mm-panel::-webkit-scrollbar { width: 4px; }\n.ecb-mm-panel::-webkit-scrollbar-track { background: transparent; }\n.ecb-mm-panel::-webkit-scrollbar-thumb { background: rgb(208, 220, 234); border-radius: 2px; }\n.ecb-mm-panel.active { display: block; }\n.ecb-mm-nav { list-style: none; margin: 0px; padding: 6px 0px; }\n.ecb-mm-nav-link, .ecb-mm-toggle { display: flex; align-items: center; gap: 12px; width: 100%; padding: 13px 20px; font-size: 14px; font-weight: 500; color: rgb(44, 62, 86); text-decoration: none; background: none; border-width: medium medium medium 3px; border-style: none none none solid; border-color: currentcolor currentcolor currentcolor transparent; border-image: none; cursor: pointer; text-align: left; transition: background 0.15s, color 0.15s, border-color 0.15s; position: relative; }\n.ecb-mm-nav-link:hover, .ecb-mm-toggle:hover { background: rgb(244, 248, 255); color: rgb(22, 131, 255); border-left-color: rgb(184, 212, 255); }\n.ecb-mm-nav-link svg, .ecb-mm-toggle > svg:first-child { flex-shrink: 0; color: rgb(154, 172, 191); }\n.ecb-mm-nav-link:hover svg, .ecb-mm-toggle:hover > svg:first-child { color: rgb(22, 131, 255); }\n.ecb-mm-chevron { margin-left: auto; transition: transform 0.25s; color: rgb(176, 190, 200); flex-shrink: 0; }\n.ecb-mm-children { list-style: none; margin: 0px 0px 0px 20px; padding: 0px; max-height: 0px; overflow: hidden; transition: max-height 0.28s; background: rgb(247, 249, 252); border-left: 3px solid rgb(224, 232, 240); }\n.ecb-mm-child-link { display: block; padding: 10px 16px 10px 24px; font-size: 13px; color: rgb(90, 106, 128); text-decoration: none; transition: color 0.15s, background 0.15s; border-left: 2px solid transparent; }\n.ecb-mm-child-link:hover { color: rgb(22, 131, 255); background: rgb(238, 245, 255); }\n.ecb-mm-divider { height: 1px; background: rgb(238, 242, 247); margin: 6px 16px; }\n.ecb-mm-auth { display: flex; flex-direction: column; gap: 8px; padding: 8px 16px 12px; }\n.ecb-mm-auth-btn { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 11px 16px; border-radius: 10px; font-size: 13.5px; font-weight: 700; text-decoration: none; text-align: center; transition: background 0.2s, transform 0.15s, box-shadow 0.2s; cursor: pointer; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }\n.ecb-mm-auth-btn:active { transform: scale(0.98); }\n.ecb-mm-auth-btn--primary { background: rgb(22, 131, 255); color: rgb(255, 255, 255); box-shadow: rgba(22, 131, 255, 0.28) 0px 3px 12px; }\n.ecb-mm-auth-btn--primary: