  L("Laptop brands", "HP laptops", "/laptops/hp-laptops-kenya", "HP laptops price in Kenya", ["hp laptops in kenya", "hp laptop prices nairobi"], "commercial", "Mapped", ["I need a shop in Nairobi to buy an HP laptop"]),
