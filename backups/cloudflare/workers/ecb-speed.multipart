Content-Disposition: form-data; name="skin.js"

// "Monochrome" skin for the ECB GeniusCart theme, in the design language of
// nothing.tech (DESIGN.md "Nothing"): pure black / white / grey, a dot-matrix
// display face for headings and prices, uppercase monospace for every label
// and button, light sans for editorial text, grey product tiles, 6px buttons,
// 8px cards, hairline borders, a sparse dot grid on the page background.
//
// Open-licence fonts stand in for Nothing's proprietary ones:
//   Ndot -> Doto (dot matrix), LatteraMono -> Space Mono, NType82 -> Inter.
// Injected by the ecb-speed Worker after all theme CSS, so it wins on equal
// specificity; !important is used where the theme uses it or sets inline styles.

export const SKIN_FONTS =
  "https://fonts.googleapis.com/css2?family=Doto:wght@700;900&amp;family=Inter:wght@300;400;500;600&amp;family=Space+Mono:wght@400;700&amp;display=swap";

const T = {
  ink: "#000",
  canvas: "#fff",
  muted: "#5c5e5e",
  hair: "#e2e2e2",
  page: "#f2f2f2",
  tile: "#e9e9e9",
  dot: '"Doto", ui-monospace, monospace',
  mono: '"Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace',
  sans: '"Inter", system-ui, -apple-system, "Segoe UI", sans-serif',
};

// Small helpers to keep the rules readable.
const label = `font-family:${T.mono}!important;text-transform:uppercase!important;letter-spacing:.06em!important;font-weight:400!important`;
const display = `font-family:${T.dot}!important;font-weight:900!important;text-transform:uppercase!important;letter-spacing:.02em!important;line-height:1.05!important`;
const btnPrimary = `background:${T.ink}!important;color:${T.canvas}!important;border:1px solid ${T.ink}!important;border-radius:6px!important;box-shadow:none!important;${label};font-size:11.5px!important`;
const btnSecondary = `background:${T.canvas}!important;color:${T.ink}!important;border:1px solid ${T.ink}!important;border-radius:6px!important;box-shadow:none!important;${label};font-size:11.5px!important`;

export const SKIN_CSS = [
  // ---------- base ----------
  `:root{--ecb-ink:${T.ink};--ecb-page:${T.page}}`,
  `html,body{background-color:${T.page}!important}`,
  `body{background-image:radial-gradient(circle,#c4c4c4 1px,transparent 1.5px)!important;background-size:160px 160px!important;background-position:40px 40px!important;color:${T.ink}!important;font-family:${T.sans}!important;-webkit-font-smoothing:antialiased}`,
  `body :where(h1,h2,h3,h4,h5,h6,p,a,span,li,td,th,label,button,input,select,textarea,strong,small,em,b,div,dt,dd,option){font-family:${T.sans}}`,
  `body :where(h1,h2,h3,h4,h5,h6){color:${T.ink}}`,
  `::selection{background:${T.ink};color:${T.canvas}}`,
  `.ecb-cats-strip,.ecb-brands-section,.ecb-featured-section,.ecb-promos-section,.ecb-bestsell-section,.ecb-uniq-section,.ecb-why-section,.ecb-visit-section,.ecb-seo-intro,.ecb-cat-section,.ecb-pd-section,.ecb-pd-tabs-section,.ecb-pd-related-section,.ecb-about-page,main{background:transparent!important}`,
  `.ecb-seo-intro{border:0!important}`,

  // ---------- top bar ----------
  `.ecb-topbar{background:${T.ink}!important;border:0!important}`,
  `.ecb-topbar,.ecb-topbar *{color:${T.canvas}!important}`,
  `.ecb-topbar__address,.ecb-topbar__hours,.ecb-topbar__phone,.ecb-topbar__login-btn{${label};font-size:10.5px!important}`,
  `.ecb-topbar__login-btn{background:transparent!important;border:1px solid rgba(255,255,255,.35)!important;border-radius:6px!important;box-shadow:none!important}`,
  `.ecb-topbar__login-btn:hover{background:${T.canvas}!important;color:${T.ink}!important}`,
  `.ecb-topbar__social-link{background:transparent!important;border:1px solid rgba(255,255,255,.25)!important;border-radius:6px!important}`,
  `.ecb-topbar__divider{background:rgba(255,255,255,.25)!important}`,
  `.ecb-topbar svg,.ecb-topbar i{color:${T.canvas}!important;fill:currentColor}`,

  // ---------- header (white capsule) ----------
  `.ecb-header{background:transparent!important;box-shadow:none!important;border:0!important}`,
  `.ecb-midbar{background:${T.page}!important;border:0!important;box-shadow:none!important}`,
  `@media (min-width:992px){.ecb-midbar{padding:10px 0 0!important}.ecb-midbar__inner{background:${T.canvas}!important;border:1px solid ${T.hair}!important;border-radius:10px!important;padding:10px 20px!important}}`,
  `.ecb-midbar__logo-img{display:none!important}`,
  `.ecb-midbar__logo{display:inline-flex!important;align-items:center!important;text-decoration:none!important}`,
  `.ecb-midbar__logo::after{content:"ECB TECHNOLOGIES";${display};font-size:22px;color:${T.ink};white-space:nowrap}`,
  `@media (max-width:575px){.ecb-midbar__logo::after{font-size:17px}}`,
  `.ecb-midbar__search{background:${T.page}!important;border:1px solid transparent!important;border-radius:6px!important;box-shadow:none!important}`,
  `.ecb-midbar__search-input{background:transparent!important;${label};font-size:11.5px!important;color:${T.ink}!important}`,
  `.ecb-midbar__search-input::placeholder{color:${T.muted}!important;opacity:1}`,
  `.ecb-midbar__search-btn{background:${T.ink}!important;border-radius:6px!important;box-shadow:none!important;border:0!important}`,
  `.ecb-midbar__search-btn svg,.ecb-midbar__search-btn i{color:${T.canvas}!important}`,
  `.ecb-midbar__search-icon,.ecb-midbar__action-link,.ecb-midbar__action-link svg,.ecb-midbar__mobile-toggle,.ecb-midbar__mobile-toggle svg{color:${T.ink}!important}`,
  `.ecb-midbar__action-label{${label};font-size:9.5px!important;color:${T.ink}!important}`,
  `.ecb-midbar__badge,.ecb-midbar__badge--cart{background:${T.ink}!important;color:${T.canvas}!important;font-family:${T.mono}!important;box-shadow:none!important;border:0!important}`,

  // ---------- main menu ----------
  `.ecb-navbar{background:${T.page}!important;border:0!important;box-shadow:none!important}`,
  `.ecb-navbar__all-cats-btn{${btnPrimary};height:36px!important}`,
  `.ecb-navbar__all-cats-btn svg,.ecb-navbar__caret{color:${T.canvas}!important}`,
  `.ecb-navbar__link{${label};font-size:11px!important;color:${T.ink}!important;background:transparent!important;border-radius:0!important;box-shadow:none!important}`,
  `.ecb-navbar::after{display:none!important}`,
  `.ecb-navbar__link::after{background:${T.ink}!important;height:1px!important}`,
  `.ecb-navbar__cat-item::before{background:${T.ink}!important}`,
  `.ecb-navbar__link--deals{background:transparent!important;color:${T.ink}!important;border:1px solid ${T.ink}!important;border-radius:6px!important}`,
  `.ecb-navbar__cat-dropdown{border:1px solid ${T.hair}!important;border-radius:8px!important;box-shadow:none!important}`,
  `.ecb-navbar__cat-item,.ecb-navbar__cat-item a{${label};font-size:11px!important;color:${T.ink}!important}`,

  // ---------- mobile menu ----------
  `.ecb-mobile-menu{background:${T.canvas}!important}`,
  `.ecb-mm-nav-link,.ecb-mm-child-link,.ecb-mm-cat-link,.ecb-mm-tab,.ecb-mm-contact-item{${label};font-size:11.5px!important;color:${T.ink}!important}`,
  `.ecb-mm-tab.active,.ecb-mm-tab[aria-selected="true"]{background:${T.ink}!important;color:${T.canvas}!important}`,
  `.ecb-mm-auth-btn--primary{${btnPrimary}}.ecb-mm-auth-btn--outline{${btnSecondary}}`,
  `.ecb-mm-header{background:${T.canvas}!important;border-bottom:1px solid ${T.hair}!important}`,
  `.ecb-mm-contact-strip{background:${T.ink}!important}.ecb-mm-contact-strip *{color:${T.canvas}!important}`,

  // ---------- hero ----------
  `.ecb-hero-wrapper,.ecb-hero-slide{background:${T.ink}!important;border-radius:10px!important;box-shadow:none!important}`,
  `.ecb-hero-overlay{background:linear-gradient(90deg,#000 0%,#000 24%,rgba(0,0,0,.92) 32%,rgba(0,0,0,.55) 50%,rgba(0,0,0,.1) 70%,transparent 100%)!important}`,
  `@media (max-width:991px){.ecb-hero-overlay{background:linear-gradient(180deg,rgba(0,0,0,.55) 0%,rgba(0,0,0,.8) 45%,rgba(0,0,0,.95) 100%)!important}}`,
  `@media (max-width:767px){.ecb-hero-overlay{background:linear-gradient(100deg,#000 0%,rgba(0,0,0,.95) 40%,rgba(0,0,0,.55) 62%,rgba(0,0,0,.08) 100%)!important}}`,
  `.ecb-hero-img-bg{filter:brightness(.9) saturate(.85)!important}`,
  `.ecb-hero-eyebrow{${label};font-size:11px!important;color:#bdbdbd!important;letter-spacing:.18em!important}`,
  `.ecb-hero-title{${display};color:${T.canvas}!important;font-size:64px!important}`,
  `@media (max-width:1199px){.ecb-hero-title{font-size:48px!important}}`,
  `@media (max-width:767px){.ecb-hero-title{font-size:28px!important}}`,
  `.ecb-hero-badge{background:transparent!important;border-color:rgba(255,255,255,.22)!important;border-radius:6px!important}`,
  `.ecb-hero-badge span,.ecb-hero-badge{${label};font-size:10px!important;color:${T.canvas}!important}`,
  `.ecb-hero-badge-icon{background:transparent!important;border:1px solid rgba(255,255,255,.4)!important;color:${T.canvas}!important}`,
  `.ecb-hero-badge-icon svg{color:${T.canvas}!important;stroke:currentColor}`,
  `.ecb-hero-btn{background:${T.canvas}!important;color:${T.ink}!important;border:0!important;border-radius:6px!important;box-shadow:none!important;${label};font-size:12px!important}`,
  `.ecb-hero-btn svg{color:${T.ink}!important}`,
  `.ecb-hero-bc-line1{${label};font-size:11px!important;color:${T.canvas}!important}`,
  `.ecb-hero-bc-line2{${display};color:${T.canvas}!important;font-size:26px!important}`,
  `.ecb-hero-bc-arrow path{stroke:${T.canvas}!important}`,
  `.ecb-hero-dot{background:rgba(255,255,255,.35)!important;box-shadow:none!important;border:0!important}.ecb-hero-dot.active{background:${T.canvas}!important}`,

  // ---------- home intro (SEO block) ----------
  `.ecb-seo-intro h1{font-family:${T.sans}!important;font-weight:300!important;font-size:32px!important;letter-spacing:-.01em!important;color:${T.ink}!important}`,
  `@media (max-width:767px){.ecb-seo-intro h1{font-size:24px!important}}`,
  `.ecb-seo-intro p{color:${T.muted}!important;font-size:15px!important}`,
  `.ecb-seo-intro p a{color:${T.ink}!important;text-decoration:underline!important;text-underline-offset:3px}`,
  `.ecb-seo-cta a{height:40px!important;padding:0 16px!important}`,
  `.ecb-seo-cta .ecb-cta-wa{${btnPrimary}}.ecb-seo-cta .ecb-cta-call,.ecb-seo-cta .ecb-cta-shop{${btnSecondary}}`,

  // ---------- section titles ----------
  `.ecb-brands-title,.ecb-featured-title,.ecb-bestsell-title,.ecb-uniq-title,.ecb-why-title,.ecb-visit-title{${display};font-size:34px!important;color:${T.ink}!important}`,
  `@media (max-width:767px){.ecb-brands-title,.ecb-featured-title,.ecb-bestsell-title,.ecb-uniq-title,.ecb-why-title,.ecb-visit-title{font-size:24px!important}}`,
  `.ecb-fire-icon,.ecb-bestsell-badge{display:none!important}`,
  `.ecb-uniq-eyebrow,.ecb-visit-eyebrow,.ecb-visit-detail-label{${label};font-size:10.5px!important;color:${T.muted}!important}`,
  `.ecb-uniq-eyebrow svg,.ecb-visit-eyebrow svg{display:none!important}`,
  `.ecb-uniq-subtitle,.ecb-visit-tagline{color:${T.muted}!important;font-size:14px!important}`,
  `.ecb-featured-viewall,.ecb-bestsell-viewall,.ecb-uniq-viewall,.ecb-brands-viewall{${btnSecondary};padding:9px 14px!important}`,
  `.ecb-featured-viewall svg,.ecb-bestsell-viewall svg,.ecb-uniq-viewall svg,.ecb-brands-viewall svg{color:${T.ink}!important}`,
  `.ecb-bestsell-arrow,.ecb-uniq-arrow,.ecb-fp-arrow{background:${T.canvas}!important;color:${T.ink}!important;border:1px solid ${T.hair}!important;box-shadow:none!important;border-radius:6px!important}`,
  `.slick-dots li button{background:#c4c4c4!important;box-shadow:none!important;border:0!important}`,
  `.slick-dots li.slick-active button{background:${T.ink}!important}`,

  // ---------- category strip ----------
  `.ecb-cats-strip{border:0!important}`,
  `.ecb-cat-item{background:transparent!important;box-shadow:none!important}`,
  `.ecb-cat-icon{background:${T.tile}!important;border-radius:8px!important;box-shadow:none!important;border:0!important;overflow:hidden}`,
  `.ecb-cat-icon img{border-radius:8px!important}`,
  `.ecb-cat-name{${label};font-size:10px!important;color:${T.ink}!important}`,

  // ---------- brands ----------
  `.ecb-brand-logo{background:${T.canvas}!important;border:1px solid ${T.hair}!important;border-radius:6px!important;box-shadow:none!important}`,
  `.ecb-brand-logo:hover{border-color:${T.ink}!important}`,
  `.ecb-brand-text{${label};color:${T.ink}!important;font-size:12px!important;font-weight:700!important}`,
  `.ecb-brands-chevron{color:${T.ink}!important}`,

  // ---------- featured tabs ----------
  `.ecb-featured-tabs{border-bottom:1px solid ${T.hair}!important;background:transparent!important}`,
  `.ecb-feat-tab{${label};font-size:11px!important;color:${T.muted}!important;background:transparent!important;border:0!important;border-radius:0!important;box-shadow:none!important}`,
  `.ecb-feat-tab.active,.ecb-feat-tab:hover{color:${T.ink}!important;box-shadow:inset 0 -2px 0 ${T.ink}!important}`,

  // ---------- product cards (all grids and carousels) ----------
  `.ecb-fp-card,.ecb-bs-card,.ecb-uniq-card,.ecb-cat-list-card{background:${T.tile}!important;border:0!important;border-radius:8px!important;box-shadow:none!important;transform:none!important}`,
  // Image areas carry the tile colour so white photo backgrounds can blend
  // into it (carousels create their own layer, so the card colour alone isn't enough).
  `.ecb-fp-img-wrap,.ecb-bs-img-wrap,.ecb-uniq-img-wrap,.ecb-cat-list-img,.ecb-bs-img-link,.ecb-uniq-img-link{background:${T.tile}!important;border:0!important}`,
  `.ecb-fp-img-wrap::before,.ecb-bs-img-wrap::before,.ecb-uniq-img-wrap::before,.ecb-fp-img-wrap::after,.ecb-bs-img-wrap::after,.ecb-uniq-img-wrap::after{display:none!important}`,
  `.ecb-fp-img-wrap img,.ecb-bs-img-wrap img,.ecb-uniq-img-wrap img,.ecb-cat-list-img img{mix-blend-mode:multiply;background:transparent!important}`,
  `.ecb-fp-body,.ecb-bs-body,.ecb-uniq-body,.ecb-cat-list-body,.ecb-fp-footer,.ecb-bs-footer,.ecb-uniq-footer{background:transparent!important;text-align:center}`,
  `.ecb-fp-name,.ecb-bs-name,.ecb-uniq-name,.ecb-cat-list-name{${label};font-size:12px!important;line-height:1.4!important;color:${T.ink}!important;font-weight:400!important}`,
  `.ecb-fp-specs,.ecb-bs-specs,.ecb-uniq-desc{display:none!important}`,
  `.ecb-cat-list-desc{color:${T.muted}!important;font-size:13px!important}`,
  `.ecb-fp-price,.ecb-bs-price,.ecb-uniq-price,.ecb-cat-list-price{font-family:${T.mono}!important;font-size:14px!important;font-weight:700!important;color:${T.ink}!important;letter-spacing:.02em!important}`,
  `.ecb-fp-price-old,.ecb-uniq-price-old,.ecb-fp-card del,.ecb-bs-card del,.ecb-uniq-card del{font-family:${T.mono}!important;color:#8c8c8c!important;font-size:12px!important}`,
  `.ecb-bs-price-row,.ecb-uniq-price-row{justify-content:center!important}`,
  `.ecb-fp-cart-btn,.ecb-bs-cart-btn,.ecb-uniq-cart-btn,.ecb-cat-list-view-btn{${btnPrimary};height:40px!important}`,
  `.ecb-fp-cart-btn svg,.ecb-bs-cart-btn svg,.ecb-uniq-cart-btn svg,.ecb-cat-list-view-btn svg{color:${T.canvas}!important}`,
  `.ecb-fp-cart-btn:hover,.ecb-bs-cart-btn:hover,.ecb-uniq-cart-btn:hover{background:#222!important}`,
  `.ecb-fp-badge,.ecb-bs-badge,.ecb-uniq-badge{background:${T.canvas}!important;color:${T.ink}!important;${label};font-size:9px!important;border-radius:4px!important;box-shadow:none!important;border:1px solid ${T.hair}!important}`,
  `.ecb-fp-wish,.ecb-bs-wish,.ecb-uniq-wish,.ecb-cat-list-wish,.ecb-pd-img-wish{background:${T.canvas}!important;border:1px solid ${T.hair}!important;box-shadow:none!important}`,
  `.ecb-fp-wish path,.ecb-bs-wish path,.ecb-uniq-wish path,.ecb-cat-list-wish path,.ecb-pd-img-wish path{stroke:${T.ink}!important}`,

  // ---------- promos ----------
  `.ecb-promo-card{background:${T.ink}!important;border-radius:8px!important;box-shadow:none!important}`,
  `.ecb-promo-tag{${label};font-size:10px!important;color:#bdbdbd!important;background:transparent!important}`,
  `.ecb-promo-title{${display};color:${T.canvas}!important;font-size:20px!important;max-width:100%;overflow-wrap:anywhere}`,
  `.ecb-promo-body{position:relative;z-index:1;min-width:0}`,
  `.ecb-promo-cta{${label};font-size:11px!important;color:${T.canvas}!important}`,
  `.ecb-promo-img img{filter:saturate(.85)}`,

  // ---------- why / visit / trust ----------
  `.ecb-why-grid{border:1px solid ${T.hair}!important;border-radius:8px!important;background:${T.canvas}!important;box-shadow:none!important}`,
  `.ecb-why-item{border-color:${T.hair}!important;background:transparent!important}`,
  `.ecb-why-icon,.ecb-visit-detail-icon,.ecb-trust-icon{background:${T.page}!important;color:${T.ink}!important;border:0!important;box-shadow:none!important}`,
  `.ecb-why-icon svg,.ecb-visit-detail-icon svg{color:${T.ink}!important;stroke:currentColor}`,
  `.ecb-why-label{${label};font-size:11px!important;color:${T.ink}!important}`,
  `.ecb-visit-grid{grid-template-columns:1fr!important}`,
  `.ecb-visit-media{display:none!important}`,
